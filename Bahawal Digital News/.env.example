# Server-side Neon PostgreSQL connection string. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Managed Neon Auth configuration. Keep the cookie secret private (32+ characters).
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/DB/auth
NEON_AUTH_COOKIE_SECRET=generate-a-unique-random-secret-at-least-32-characters

# Set to the owner's Neon Auth email only during initial newsroom bootstrap.
BDN_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
NEXT_PUBLIC_SITE_URL=https://bahawal-digital-news.vercel.app

# BDN_ADMIN_TOKEN is deprecated; CMS endpoints use Neon Auth sessions and staff roles.
